<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="MediatR" Version="[12.5.0, 13.0.0)"/>
        <PackageVersion Include="FluentValidation" Version="12.1.1"/>
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.4"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.4"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.4"/>
        <!-- Testing -->
        <PackageVersion Include="FluentAssertions" Version="[7.2.2, 8.0.0)"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0"/>
        <PackageVersion Include="xunit" Version="2.9.3"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.4"/>
    </ItemGroup>
</Project>
